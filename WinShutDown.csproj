<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.7.2+ встроен в Windows 10 (1803+) и Windows 11 — ничего доустанавливать не нужно -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WinShutDown</AssemblyName>
    <RootNamespace>WinShutDown</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.4.1</Version>
    <Product>WinShutDown</Product>
    <Company>WinShutDown</Company>
    <Description>Принудительное выключение компьютера по расписанию (родительский контроль)</Description>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\Web\admin.html" LogicalName="WinShutDown.admin.html" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
